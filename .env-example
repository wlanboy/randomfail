# Konfiguration für randomfail (Defaults aus main.py)
# Nutzung:
#   uv run --env-file .env uvicorn main:app --host 0.0.0.0 --port 8080
#   docker run --env-file .env -p 8080:8080 randomfail
# Hinweis: Kommentare nur in eigenen Zeilen, docker --env-file kennt keine Inline-Kommentare.

# false: automatischer Chaos-Loop startet pausiert (per /chaos/resume aktivierbar), GET / liefert keine HTTP-500-Fehler
CHAOS_ENABLED=false

# Sekunden zwischen automatischen Chaos-Zyklen
CHAOS_INTERVAL=300

# Sekunden Wartezeit nach dem Start vor dem ersten Zyklus
CHAOS_STARTUP_DELAY=10

# Bytes pro Speicher-Chunk im OOM-Szenario (1 MB)
MEMORY_CHUNK_SIZE=1000000

# Größe der Junk-Datei für das DISK_FILL-Szenario in MB
DISK_FILL_SIZE_MB=110

# Anzahl paralleler Prozesse im CPU_BURN-Szenario (je ein Kern)
CPU_BURN_WORKERS=2

# Sekunden Dauer des CPU-Burns (empfohlen: max. CHAOS_INTERVAL / 2)
CPU_BURN_DURATION=120

# Sekunden künstliche Verzögerung pro Request im SLOW_RESPONSE-Szenario
SLOW_RESPONSE_DELAY=5

# true: SLOW_RESPONSE verzögert auch /healthz und /readyz (führt zu Liveness-Restarts)
SLOW_AFFECTS_PROBES=false

# Sekunden Wartezeit nach SIGTERM vor dem Prozess-Exit
SIGTERM_DELAY=30

# Sekunden zwischen Readiness-Toggles im READINESS_FLAP-Szenario
READINESS_FLAP_INTERVAL=5

# Soft-Limit für offene FDs im FD_EXHAUSTION-Szenario, 0 = Limit nicht ändern
FD_EXHAUSTION_LIMIT=1024
